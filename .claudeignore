# .claudeignore — Files Claude Code should never read
# Syntax: same as .gitignore

# ── Secrets & credentials ──────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.development
.env.production
.env.test
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
*secret*
*password*
*token*

# ── Cloud provider configs ─────────────────────────────────────────────────────
.aws/
.gcp/
.azure/
.config/gcloud/
kubeconfig
*.kubeconfig

# ── SSH ────────────────────────────────────────────────────────────────────────
.ssh/
id_rsa
id_ed25519
known_hosts

# ── Docker / infra ─────────────────────────────────────────────────────────────
docker-compose.override.yml
# Note: keep docker-compose.yml readable if it has no secrets

# ── Database ───────────────────────────────────────────────────────────────────
config/database.yml
database.yml
*.sqlite
*.db

# ── Dependencies (large, rarely useful to read) ────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
build/
.next/
out/
*.min.js
*.min.css

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── OS & editor ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# ── Large binary / media ───────────────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mp3
*.pdf
*.zip
*.tar.gz

# ── Legacy / deprecated (add your own) ────────────────────────────────────────
# legacy/
# old/
